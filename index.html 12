<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Cruz Tires & Batteries – Lake Elsinore, CA</title>
<meta name="description" content="Cruz Tires & Batteries in Lake Elsinore, CA. New & used tires, battery replacement, same-day service. Call (951) 471-0774."/>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@400;500;600;700;800;900&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet"/>
<style>
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

:root {
  --black:      #0A0A0A;
  --charcoal:   #151515;
  --steel:      #1C1F24;
  --steel-lt:   #262A30;
  --blue:       #00AEEF;
  --blue-dim:   #0080B0;
  --blue-glow:  rgba(0,174,239,0.35);
  --silver:     #D9D9D9;
  --white:      #FFFFFF;
  --offwhite:   #F5F5F5;
  --mute:       #8A93A0;
  --ease:       cubic-bezier(0.16,1,0.3,1);
  --spring:     cubic-bezier(0.34,1.56,0.64,1);
}

html { scroll-behavior: smooth; }

body {
  background: var(--black);
  color: var(--white);
  font-family: 'Inter', sans-serif;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

::selection { background: var(--blue); color: var(--black); }

/* ── SCROLL REVEAL ── */
.rv { opacity: 0; transform: translateY(36px); transition: opacity 0.9s var(--ease), transform 0.9s var(--ease); }
.rv.in { opacity: 1; transform: translateY(0); }
.rv-scale { opacity: 0; transform: scale(0.92); transition: opacity 0.8s var(--ease), transform 0.8s var(--ease); }
.rv-scale.in { opacity: 1; transform: scale(1); }
.d1{transition-delay:.08s}.d2{transition-delay:.16s}.d3{transition-delay:.24s}.d4{transition-delay:.32s}.d5{transition-delay:.4s}.d6{transition-delay:.48s}

/* ── FLOATING ANIMATION ── */
@keyframes floatY { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-14px)} }
@keyframes floatYSm { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-7px)} }
@keyframes pulseGlow { 0%,100%{opacity:0.5} 50%{opacity:1} }
@keyframes spin360 { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
@keyframes drift { 0%{transform:translate(0,0)} 33%{transform:translate(20px,-25px)} 66%{transform:translate(-15px,15px)} 100%{transform:translate(0,0)} }

/* ── PARTICLE FIELD (background ambiance) ── */
.particles {
  position: fixed; inset: 0; z-index: 0; pointer-events: none; overflow: hidden;
}
.particle {
  position: absolute; border-radius: 50%;
  background: var(--blue);
  opacity: 0.15;
  filter: blur(1px);
  animation: drift 18s ease-in-out infinite;
}

/* ── NAV ── */
nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 500;
  display: flex; align-items: center; justify-content: space-between;
  padding: 18px 5vw;
  background: rgba(10,10,10,0.7);
  backdrop-filter: blur(20px) saturate(1.3);
  -webkit-backdrop-filter: blur(20px) saturate(1.3);
  border-bottom: 1px solid rgba(0,174,239,0.12);
  transition: padding 0.3s var(--ease), background 0.3s;
}
nav.scrolled { padding: 12px 5vw; background: rgba(10,10,10,0.92); }

.nav-logo {
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 800; font-size: 1.4rem;
  letter-spacing: 0.04em; color: var(--white);
  text-decoration: none; line-height: 1;
  display: flex; flex-direction: column;
}
.nav-logo span { color: var(--blue); }
.nav-logo small {
  font-family: 'Inter', sans-serif;
  font-size: 0.55rem; font-weight: 500; letter-spacing: 0.25em;
  text-transform: uppercase; color: var(--mute); margin-top: 2px;
}

.nav-links { display: flex; align-items: center; gap: 4px; }
.nav-link {
  font-size: 0.82rem; font-weight: 500; color: var(--silver);
  text-decoration: none; padding: 9px 16px;
  transition: color 0.2s; letter-spacing: 0.01em;
}
.nav-link:hover { color: var(--blue); }

.nav-cta {
  display: inline-flex; align-items: center; gap: 8px;
  background: var(--blue); color: var(--black);
  font-family: 'Barlow Condensed', sans-serif;
  font-weight: 700; font-size: 1rem; letter-spacing: 0.04em;
  text-decoration: none; padding: 11px 22px; border-radius: 8px;
  transition: all 0.25s var(--ease);
  box-shadow: 0 0 0 0 var(--blue-glow);
  white-space: nowrap;
}
.nav-cta:hover { background: var(--white); box-shadow: 0 0 24px 4px var(--blue-glow); transform: translateY(-1px); }
.nav-cta svg { width: 16px; height: 16px; }

@media (max-width: 860px) { .nav-links a:not(.nav-cta) { display: none; } }

/* ── HERO ── */
.hero {
  min-height: 100svh;
  display: flex; flex-direction: column; justify-content: center;
  position: relative; overflow: hidden;
  padding: 110px 5vw 60px;
}

/* mesh gradient background, animated */
.hero-mesh {
  position: absolute; inset: -10%; z-index: 0;
  background:
    radial-gradient(ellipse 55% 50% at 85% 25%, rgba(0,174,239,0.22) 0%, transparent 60%),
    radial-gradient(ellipse 45% 45% at 10% 80%, rgba(0,174,239,0.10) 0%, transparent 60%),
    radial-gradient(ellipse 70% 60% at 50% 100%, rgba(217,217,217,0.04) 0%, transparent 70%),
    var(--black);
  animation: meshShift 16s ease-in-out infinite;
}
@keyframes meshShift {
  0%,100% { filter: hue-rotate(0deg) brightness(1); }
  50% { filter: hue-rotate(8deg) brightness(1.08); }
}

/* faint grid */
.hero-grid {
  position: absolute; inset: 0; z-index: 0; pointer-events: none;
  background-image:
    linear-gradient(rgba(0,174,239,0.04) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,174,239,0.04) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: radial-gradient(ellipse 70% 60% at 50% 40%, black 30%, transparent 80%);
}

/* ───── 3D TIRE (real DOM-built, front/back faces + cylinder wall) ───── */
.tire-scene {
  position: absolute; right: -40px; top: 50%;
  transform: translateY(-50%);
  width: 560px; height: 560px;
  perspective: 1000px;
  z-index: 1; pointer-events: none;
}
@media (max-width: 900px) {
  .tire-scene { width: 360px; height: 360px; right: -90px; top: auto; bottom: 10px; transform: none; opacity: 0.4; }
}
.tire-ring {
  width: 100%; height: 100%; position: relative;
  transform-style: preserve-3d;
  animation: spinTire 13s linear infinite;
}
@keyframes spinTire { from{transform:rotateY(0deg) rotateX(16deg)} to{transform:rotateY(360deg) rotateX(16deg)} }
@media (prefers-reduced-motion: reduce) { .tire-ring { animation: none; transform: rotateY(28deg) rotateX(16deg); } }

.tire-segment { position: absolute; inset: 0; transform-style: preserve-3d; }
.tire-face {
  position: absolute; border-radius: 50%;
  border: 66px solid rgba(28,31,36,0.96);
  width: 100%; height: 100%;
  box-shadow:
    inset 0 0 0 6px rgba(0,174,239,0.18),
    inset 0 0 0 66px rgba(10,10,12,0.6),
    0 0 80px rgba(0,174,239,0.12);
}
.tire-face.front {
  transform: translateZ(66px);
  border-color: rgba(34,38,44,0.97);
  background: radial-gradient(circle, rgba(46,50,56,1) 33%, rgba(16,17,19,1) 34%, rgba(16,17,19,1) 58%, rgba(34,38,44,1) 59%);
}
.tire-face.back {
  transform: translateZ(-66px) rotateY(180deg);
  border-color: rgba(20,22,25,0.97);
  background: radial-gradient(circle, rgba(36,40,45,1) 33%, rgba(10,11,12,1) 34%, rgba(10,11,12,1) 58%, rgba(24,27,31,1) 59%);
}
.spoke {
  position: absolute; top: 50%; left: 50%;
  width: 44%; height: 9px;
  background: linear-gradient(to right, rgba(0,200,255,0.55), rgba(120,140,155,0.4));
  transform-origin: 0 50%; border-radius: 3px; margin-top: -4.5px;
  box-shadow: 0 0 10px rgba(0,174,239,0.3);
}
.tread-ring {
  position: absolute; inset: 0; border-radius: 50%;
  background: repeating-conic-gradient(rgba(0,174,239,0.05) 0deg, rgba(0,174,239,0.05) 3deg, transparent 3deg, transparent 10deg);
}
.hub {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%,-50%) translateZ(74px);
  width: 96px; height: 96px; border-radius: 50%;
  background: radial-gradient(circle at 35% 35%, rgba(230,245,255,0.97), rgba(80,160,190,0.9) 55%, rgba(30,50,60,0.95));
  box-shadow: 0 0 0 6px rgba(0,174,239,0.25), 0 0 40px rgba(0,174,239,0.35), 0 8px 30px rgba(0,0,0,0.6);
}
.hub-inner {
  position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%);
  width: 42px; height: 42px; border-radius: 50%;
  background: radial-gradient(circle at 40% 40%, rgba(60,160,200,1), rgba(10,20,30,1));
  box-shadow: inset 0 2px 8px rgba(0,0,0,0.6);
}
.cylinder-wrap { position: absolute; inset: 0; transform-style: preserve-3d; }
.cylinder-panel {
  position: absolute; top: 0; left: 50%;
  width: 2px; height: 100%;
  background: linear-gradient(to bottom, transparent 15%, rgba(40,44,50,1) 20%, rgba(40,44,50,1) 80%, transparent 85%);
  transform-origin: 0 50%; transform-style: preserve-3d;
}

/* orbiting glow rings around tire */
.tire-orbit-ring {
  position: absolute; border-radius: 50%;
  border: 1px solid rgba(0,174,239,0.15);
  pointer-events: none;
}
.orbit-1 { inset: -40px; animation: spin360 30s linear infinite; }
.orbit-2 { inset: -80px; border-style: dashed; animation: spin360 50s linear infinite reverse; opacity: 0.5; }

/* HERO CONTENT */
.hero-content { position: relative; z-index: 3; max-width: 600px; }

.hero-badge-row { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 24px; }
.hero-badge-row .rv { display: inline-flex; }
.mini-badge {
  display: inline-flex; align-items: center; gap: 7px;
  background: rgba(0,174,239,0.08);
  border: 1px solid rgba(0,174,239,0.25);
  border-radius: 100px; padding: 6px 14px;
  font-size: 0.72rem; font-weight: 600; letter-spacing: 0.05em;
  color: var(--blue);
}
.mini-badge .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); animation: pulseGlow 2s ease-in-out infinite; }

.hero-eyebrow {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.9rem; font-weight: 600;
  letter-spacing: 0.2em; text-transform: uppercase;
  color: var(--blue); margin-bottom: 18px;
  display: flex; align-items: center; gap: 10px;
}
.hero-eyebrow::before { content:''; display:inline-block; width:30px; height:2px; background: var(--blue); box-shadow: 0 0 8px var(--blue); }

.hero-h1 {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: clamp(3.2rem, 8vw, 6rem);
  font-weight: 900; line-height: 0.95;
  letter-spacing: -0.01em; text-transform: uppercase;
  margin-bottom: 24px;
}
.hero-h1 .accent {
  color: var(--blue);
  text-shadow: 0 0 30px rgba(0,174,239,0.5);
}

.hero-sub {
  font-size: clamp(1rem, 2.2vw, 1.2rem);
  color: var(--silver); line-height: 1.6;
  max-width: 460px; margin-bottom: 38px; font-weight: 300;
}
.hero-sub strong { color: var(--white); font-weight: 600; }

.hero-ctas { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-bottom: 36px; }

.btn-primary {
  display: inline-flex; align-items: center; gap: 10px;
  background: var(--blue); color: var(--black);
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1.15rem; font-weight: 700; letter-spacing: 0.04em;
  text-decoration: none; padding: 17px 34px; border-radius: 10px;
  text-transform: uppercase;
  transition: all 0.3s var(--ease);
  box-shadow: 0 8px 30px rgba(0,174,239,0.3), 0 0 0 1px rgba(0,174,239,0.2);
  position: relative; overflow: hidden;
}
.btn-primary::before {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.35) 50%, transparent 70%);
  transform: translateX(-120%);
  transition: transform 0.6s var(--ease);
}
.btn-primary:hover::before { transform: translateX(120%); }
.btn-primary:hover { background: var(--white); box-shadow: 0 12px 44px rgba(0,174,239,0.45), 0 0 0 1px rgba(0,174,239,0.3); transform: translateY(-2px); }
.btn-primary svg { width: 20px; height: 20px; position: relative; z-index: 1; }
.btn-primary span { position: relative; z-index: 1; }

.btn-secondary {
  display: inline-flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.03); color: var(--silver);
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1.05rem; font-weight: 600; letter-spacing: 0.03em;
  text-decoration: none; padding: 15px 26px; border-radius: 10px;
  border: 1.5px solid rgba(255,255,255,0.14);
  text-transform: uppercase;
  backdrop-filter: blur(8px);
  transition: all 0.25s var(--ease);
}
.btn-secondary:hover { border-color: var(--blue); color: var(--white); background: rgba(0,174,239,0.06); transform: translateY(-2px); }

.hero-trust {
  display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
  font-size: 0.9rem; color: var(--mute);
}
.stars { color: #FFC83D; letter-spacing: 2px; filter: drop-shadow(0 0 6px rgba(255,200,61,0.4)); }

/* ── MARQUEE ── */
.marquee-strip {
  background: linear-gradient(90deg, var(--blue-dim), var(--blue), var(--blue-dim));
  overflow: hidden; padding: 15px 0;
  position: relative; z-index: 2;
  box-shadow: 0 0 40px rgba(0,174,239,0.25);
}
.marquee-inner { display: flex; align-items: center; width: max-content; animation: scrollLeft 24s linear infinite; }
@keyframes scrollLeft { from{transform:translateX(0)} to{transform:translateX(-50%)} }
.marquee-item {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1rem; font-weight: 700; letter-spacing: 0.12em;
  text-transform: uppercase; color: var(--black);
  padding: 0 28px; white-space: nowrap;
}
.marquee-dot { color: rgba(10,10,10,0.4); padding: 0 4px; }

/* ── SHARED SECTION ── */
.section { padding: 110px 5vw; position: relative; z-index: 1; }
.section.bg-charcoal {
  background: linear-gradient(180deg, var(--charcoal) 0%, var(--black) 100%);
}
.section.bg-black { background: var(--black); }
.section.bg-steel {
  background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(0,174,239,0.06) 0%, transparent 60%), var(--steel);
}

.section-label {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 0.82rem; font-weight: 700;
  letter-spacing: 0.22em; text-transform: uppercase;
  color: var(--blue); margin-bottom: 14px;
  display: flex; align-items: center; gap: 10px;
}
.section-label::before { content:''; width:24px; height:2px; background: var(--blue); box-shadow: 0 0 8px var(--blue); }

.section-title {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: clamp(2.2rem, 5vw, 3.6rem);
  font-weight: 800; text-transform: uppercase;
  color: var(--white); line-height: 1.02;
  margin-bottom: 16px;
}
.section-title em { font-style: normal; color: var(--blue); text-shadow: 0 0 24px rgba(0,174,239,0.4); }
.section-sub { color: var(--mute); font-size: 1.02rem; line-height: 1.65; max-width: 560px; margin-bottom: 56px; font-weight: 300; }

/* ── LIVE STATS ── */
.stats-wrap {
  display: grid; grid-template-columns: repeat(4,1fr);
  gap: 1px; background: rgba(0,174,239,0.1);
  border-radius: 18px; overflow: hidden;
  border: 1px solid rgba(0,174,239,0.15);
  box-shadow: 0 30px 80px rgba(0,0,0,0.5);
}
.stat-cell {
  background: linear-gradient(160deg, rgba(28,31,36,0.9), rgba(10,10,10,0.95));
  padding: 44px 24px; text-align: center;
  position: relative; overflow: hidden;
  transition: background 0.3s;
}
.stat-cell:hover { background: linear-gradient(160deg, rgba(0,174,239,0.1), rgba(10,10,10,0.95)); }
.stat-cell::before {
  content:''; position:absolute; top:-50%; left:-50%; width:200%; height:200%;
  background: radial-gradient(circle, rgba(0,174,239,0.08) 0%, transparent 60%);
  opacity: 0; transition: opacity 0.4s;
}
.stat-cell:hover::before { opacity: 1; }
.stat-icon { font-size: 1.8rem; margin-bottom: 14px; display: block; animation: floatYSm 4s ease-in-out infinite; }
.stat-num {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: clamp(2.4rem, 4vw, 3.4rem); font-weight: 900;
  color: var(--white); line-height: 1;
  text-shadow: 0 0 30px rgba(0,174,239,0.25);
}
.stat-num .plus { color: var(--blue); }
.stat-label { font-size: 0.82rem; color: var(--mute); margin-top: 8px; letter-spacing: 0.04em; text-transform: uppercase; }
@media (max-width: 760px) { .stats-wrap { grid-template-columns: repeat(2,1fr); } }

/* ── SERVICES — glassmorphism cards ── */
.services-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(250px,1fr));
  gap: 22px; max-width: 1100px;
}
.service-card {
  background: rgba(255,255,255,0.03);
  backdrop-filter: blur(16px);
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: 16px; padding: 34px 28px;
  transition: transform 0.35s var(--spring), box-shadow 0.35s var(--ease), border-color 0.3s;
  position: relative; overflow: hidden;
}
.service-card::after {
  content:''; position: absolute; inset: 0; border-radius: 16px;
  background: linear-gradient(160deg, rgba(0,174,239,0.08), transparent 50%);
  opacity: 0; transition: opacity 0.35s;
}
.service-card:hover {
  transform: translateY(-10px);
  box-shadow: 0 24px 60px rgba(0,174,239,0.18), 0 0 0 1px rgba(0,174,239,0.25);
  border-color: rgba(0,174,239,0.3);
}
.service-card:hover::after { opacity: 1; }
.service-card.featured { border-color: rgba(0,174,239,0.35); background: rgba(0,174,239,0.05); }
.service-featured-tag {
  position: absolute; top: 18px; right: 18px;
  background: var(--blue); color: var(--black);
  font-size: 0.62rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  padding: 4px 10px; border-radius: 100px;
}
.service-icon {
  width: 56px; height: 56px; border-radius: 14px;
  background: linear-gradient(145deg, var(--blue), var(--blue-dim));
  display: flex; align-items: center; justify-content: center;
  margin-bottom: 22px; position: relative; z-index: 1;
  box-shadow: 0 8px 24px rgba(0,174,239,0.3);
  transition: transform 0.3s var(--spring);
}
.service-card:hover .service-icon { transform: scale(1.12) rotate(-6deg); }
.service-icon svg { width: 28px; height: 28px; color: var(--black); }
.service-name {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1.3rem; font-weight: 700; text-transform: uppercase;
  color: var(--white); margin-bottom: 10px; position: relative; z-index: 1;
}
.service-desc { font-size: 0.9rem; color: var(--mute); line-height: 1.6; position: relative; z-index: 1; }

/* ── PROCESS STEPS ── */
.process-wrap {
  display: grid; grid-template-columns: repeat(4,1fr); gap: 0;
  position: relative; max-width: 1100px;
}
.process-line {
  position: absolute; top: 38px; left: 8%; right: 8%; height: 2px;
  background: linear-gradient(90deg, transparent, rgba(0,174,239,0.35), rgba(0,174,239,0.35), transparent);
  z-index: 0;
}
.process-step { position: relative; z-index: 1; padding: 0 16px; text-align: center; }
.process-circle {
  width: 76px; height: 76px; border-radius: 50%;
  background: linear-gradient(160deg, var(--steel-lt), var(--steel));
  border: 2px solid rgba(0,174,239,0.3);
  display: flex; align-items: center; justify-content: center;
  margin: 0 auto 22px;
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1.6rem; font-weight: 800; color: var(--blue);
  box-shadow: 0 0 0 6px rgba(0,174,239,0.05), 0 10px 30px rgba(0,0,0,0.4);
  transition: transform 0.3s var(--spring), box-shadow 0.3s;
  position: relative;
}
.process-step:hover .process-circle {
  transform: scale(1.1) translateY(-4px);
  box-shadow: 0 0 0 8px rgba(0,174,239,0.12), 0 16px 36px rgba(0,174,239,0.25);
}
.process-step h4 {
  font-family: 'Barlow Condensed', sans-serif;
  font-size: 1.15rem; font-weight: 700; text-transform: uppercase;
  color: var(--white); margin-bottom: 8px; letter-spacing: 0.02em;
}
.process-step p { font-size: 0.85rem; color: var(--mute); line-height: 1.55; max-width: 220px; margin: 0 auto; }
@media (max-width: 760px) {
  .process-wrap { grid-template-columns: 1fr; gap: 36px; }
  .process-line { display: none; }
}

/* ── FEATURED VEHICLES ── */
.vehicles-grid {
  display: grid; grid-template-columns: repeat(auto-fit, minmax(230px,1fr));
  gap: 20px; max-width: 1100px;
}
.vehicle-card {
  border-radius: 16px; overflow: hidden; position: relative;
  aspect-ratio: 4/5;
  background: linear-gradient(160deg, var(--steel-lt), var(--steel));
  border: 1px solid rgba(255,255,255,0.06);
  transition: transform 0.4s var(--ease), box-shadow 0.4s;
}
.vehicle-card:hover { transform: translateY(-8px); box-shadow: 0 24px 60px rgba(0,174,239,0.2); }
.vehicle-img-slot {
  position: absolute; inset: 0;
